<%- layout("layouts/boilerplate") %>

<div class="row mt-3">
  <div class="col-8 offset-2">
    <br /><br />

    <h3>Create a New Listing</h3>

    <form method="POST" action="/listings" novalidate class="needs-validation" enctype="multipart/form-data">

      <!-- TITLE -->
      <div class="mb-3">
        <label class="form-label">Title</label>
        <input
          name="listing[title]"
          type="text"
          class="form-control"
          placeholder="Add a catchy title"
          required
        />
        <div class="invalid-feedback">Title is required</div>
      </div>

      <!-- DESCRIPTION -->
      <div class="mb-3">
        <label class="form-label">Description</label>
        <textarea
          name="listing[description]"
          class="form-control"
          placeholder="Write a short description"
          required
        ></textarea>
        <div class="invalid-feedback">Description is required</div>
      </div>

      <!-- IMAGE URL (ONLY) -->
      <!-- <div class="mb-3">
        <label class="form-label">Image URL</label>
        <input
          name="listing[image][url]"
          type="text"
          class="form-control"
          placeholder="Enter image URL / link"
        />
      </div> -->
      <!-- IMAGE URL (ONLY) -->
      <div class="mb-3">
        <label class="form-label">Upload Listing Image</label>
        <input
          name="listing[image]"
          type="file"
          class="form-control"
          required
        />
      </div>

      <!-- PRICE + COUNTRY -->
      <div class="row">
        <div class="mb-3 col-md-4">
          <label class="form-label">Price</label>
          <input
            name="listing[price]"
            type="number"
            class="form-control"
            placeholder="1200"
            required
          />
          <div class="invalid-feedback">Valid price required</div>
        </div>

        <div class="mb-3 col-md-8">
          <label class="form-label">Country</label>
          <input
            name="listing[country]"
            type="text"
            class="form-control"
            placeholder="India"
            required
          />
          <div class="invalid-feedback">Country is required</div>
        </div>
      </div>

      <!-- LOCATION -->
      <div class="mb-3">
        <label class="form-label">Location</label>
        <input
          name="listing[location]"
          type="text"
          class="form-control"
          placeholder="Guwahati, Assam"
          required
        />
        <div class="invalid-feedback">Location is required</div>
      </div>

      <br />
      <button class="btn btn-dark add-btn">Add</button>
      <br /><br />

    </form>
  </div>
</div>
