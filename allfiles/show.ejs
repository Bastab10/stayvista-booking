<%- layout("layouts/boilerplate") %>

<div class="row mt-3">

    <!-- ================= TITLE ================= -->
    <div class="col-8 offset-3">
        <h3><%= listing.title %></h3>
    </div>

    <!-- ================= LISTING CARD ================= -->
    <div class="card col-6 offset-3 show-card listing-card">

        <img
            src="<%= listing.image.url %>"
            class="card-img-top show-img"
            alt="listing_image"
        />

        <div class="card-body">

            <!-- OWNER -->
            <p class="card-text">
                Owned by
                <i>
                    <%= listing.owner
                        ? listing.owner.username
                        : "Unknown User" %>
                </i>
            </p>

            <!-- DESCRIPTION -->
            <p class="card-text">
                <%= listing.description %>
            </p>

            <!-- PRICE -->
            <p class="card-text">
                &#8377;
                <%= listing.price.toLocaleString("en-IN") %>
            </p>

            <!-- LOCATION -->
            <p class="card-text">
                <%= listing.location %>
            </p>

            <p class="card-text">
                <%= listing.country %>
            </p>

        </div>
    </div>

    <br />

    <!-- ================= EDIT / DELETE ================= -->
    <% if (
        currUser &&
        listing.owner &&
        listing.owner._id.equals(currUser._id)
    ) { %>

        <div class="btns">

            <a
                href="/listings/<%= listing._id %>/edit"
                class="btn btn-dark col-1 offset-3 edit-btn"
            >
                Edit
            </a>

            <form
                method="POST"
                action="/listings/<%= listing._id %>?_method=DELETE"
            >
                <button class="btn btn-dark offset-5">
                    Delete
                </button>
            </form>

        </div>

    <% } %>

    <!-- ================= REVIEWS SECTION ================= -->
    <div class="col-8 offset-3 mt-3">

        <hr />

        <!-- ===== ADD REVIEW ===== -->
        <% if (currUser) { %>

            <h4>Leave a Review</h4>

            <form
                action="/listings/<%= listing._id %>/reviews"
                method="POST"
                novalidate
                class="needs-validation"
            >

                <!-- ⭐ RATING -->
                <div class="mb-3 mt-3">

                    <label class="form-label">
                        Rating:
                    </label>

                    <fieldset class="starability-slot">

                        <input
                            type="radio"
                            id="no-rate"
                            class="input-no-rate"
                            name="review[rating]"
                            value="0"
                            checked
                        />

                        <input
                            type="radio"
                            id="rate1"
                            name="review[rating]"
                            value="1"
                        />
                        <label for="rate1">
                            1 star
                        </label>

                        <input
                            type="radio"
                            id="rate2"
                            name="review[rating]"
                            value="2"
                        />
                        <label for="rate2">
                            2 stars
                        </label>

                        <input
                            type="radio"
                            id="rate3"
                            name="review[rating]"
                            value="3"
                        />
                        <label for="rate3">
                            3 stars
                        </label>

                        <input
                            type="radio"
                            id="rate4"
                            name="review[rating]"
                            value="4"
                        />
                        <label for="rate4">
                            4 stars
                        </label>

                        <input
                            type="radio"
                            id="rate5"
                            name="review[rating]"
                            value="5"
                        />
                        <label for="rate5">
                            5 stars
                        </label>

                    </fieldset>

                </div>

                <!-- COMMENT -->
                <div class="mb-3 mt-3">

                    <label class="form-label">
                        Comments
                    </label>

                    <textarea
                        name="review[comment]"
                        class="form-control"
                        rows="5"
                        required
                    ></textarea>

                    <div class="invalid-feedback">
                        Comment is required.
                    </div>

                </div>

             <button class="btn btn-outline-danger rounded-pill px-4 airbnb-btn">
                 Submit
            </button>


            </form>

            <hr />

        <% } %>

        <!-- ===== ALL REVIEWS ===== -->
        <p><b>All Reviews</b></p>

        <div class="row">

            <% for (let review of listing.reviews) { %>

                <div class="card col-5 ms-3 mb-3">

                    <div class="card-body">

                        <!-- AUTHOR -->
                        <h5 class="card-title">
                            @<%= review.author
                                ? review.author.username
                                : "Anonymous" %>
                        </h5>

                        <!-- ⭐ DISPLAY RATING -->
                        <p
                            class="starability-result card-text"
                            data-rating="<%= review.rating %>"
                        ></p>

                        <!-- COMMENT -->
                        <p class="card-text">
                            <%= review.comment %>
                        </p>

                    </div>

                    <!-- DELETE REVIEW -->
                    <% if (
                        currUser &&
                        review.author &&
                        review.author._id.equals(currUser._id)
                    ) { %>

                        <form
                            class="mb-4"
                            method="POST"
                            action="/listings/<%= listing._id %>/reviews/<%= review._id %>?_method=DELETE"
                        >
                            <button class="btn btn-sm btn-dark">
                                Delete
                            </button>
                        </form>

                    <% } %>

                </div>

            <% } %>

        </div>

    </div>

</div>
